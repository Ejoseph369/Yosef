        100 * (as.numeric(a[["att"]]) / full_att - 1)
      } else {
        NA_real_
      }
      
      counter <- counter + 1L
      
      grid_list[[counter]] <- data.table(
        outcome = y,
        metric = mt,
        k = k,
        
        removed_treated = n_t,
        removed_comparison = n_c,
        
        share_treated_removed_pct = if (n_t_all > 0L) {
