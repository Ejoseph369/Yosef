extract_inference <- function(model, wb_obj, placebo_obj, outcome){
  
  att <- coef(model)["treat_post"]
  
  se_clust <- se(model)["treat_post"]
  
  ct <- coeftable(model)
  
  p_clust <- ct["treat_post","Pr(>|t|)"]
  
  if(!is.null(wb_obj)){
    
    wb_p <- wb_obj$p_val
    
    wb_ci_low  <- wb_obj$conf_int[1]
    wb_ci_high <- wb_obj$conf_int[2]
    
  } else {
    
    wb_p <- NA
    wb_ci_low <- NA
    wb_ci_high <- NA
  }
  
  data.frame(
    Outcome = outcome,
    ATT = round(att,4),
    Clustered_SE = round(se_clust,4),
    Clustered_p = round(p_clust,4),
    WildBootstrap_p = round(wb_p,4),
    WildBootstrap_CI =
      paste0("[",
             round(wb_ci_low,4),
             ", ",
             round(wb_ci_high,4),
             "]"),
    Placebo_p = round(placebo_obj$p_value,4)
  )
}

