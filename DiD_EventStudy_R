# 11. EXTRACT COEFFICIENTS k = -4 … +6  →  TABLE
# ------------------------------------------------------------
extract_coefs <- function(model, outcome) {
  cf <- coef(model)
  se <- se(model)
  idx <- grep("event_time::", names(cf))
  
  k_vals <- as.numeric(gsub(".*event_time::(-?\\d+).*", "\\1", names(cf)[idx]))
  
  out <- data.frame(
    outcome  = outcome,
    k        = k_vals,
    theta    = unname(cf[idx]),
    se       = unname(se[idx]),
    ci_lower = unname(cf[idx] - 1.96 * se[idx]),
    ci_upper = unname(cf[idx] + 1.96 * se[idx]),
    stringsAsFactors = FALSE
  )
  
  # Reference period k = -1 (normalized to 0)
  ref <- data.frame(
    outcome = outcome, k = -1,
    theta = 0, se = 0, ci_lower = 0, ci_upper = 0
  )
  
  dplyr::bind_rows(out, ref) %>%
    dplyr::arrange(k)
}

