# 13. STANDARDIZED EFFECTS FOR FOREST PLOT
# ------------------------------------------------------------
standardize <- function(did_model, outcome, data) {
  
  pre_sd <- data %>%
    filter(year < 2019) %>%
    pull(paste0(outcome, "_anom")) %>%
    sd(na.rm = TRUE)
  
  att    <- coef(did_model)["treat_post"]
  se_raw <- se(did_model)["treat_post"]
  
  data.frame(
    outcome  = outcome,
    att_raw  = round(att, 4),
    att_sd   = round(att / pre_sd, 4),
    ci_lower = round((att - 1.96 * se_raw) / pre_sd, 4),
    ci_upper = round((att + 1.96 * se_raw) / pre_sd, 4)
  )
}

