# ATT with pixel and year fixed effects.
# Returns a numeric vector: att, se, lo, hi.

fit_att <- function(y, d) {
  
  formula_att <- as.formula(
    paste0(y, " ~ treat_post | pixel_id + year")
  )
  
  model <- feols(
    formula_att,
    data = d,
    cluster = ~cluster
  )
  
  b <- coef(model)
  s <- se(model)
  
  if (!"treat_post" %in% names(b) ||
      !"treat_post" %in% names(s)) {
    stop("ATT coefficient unavailable for outcome: ", y)
  }
  
  ci <- confint(model, parm = "treat_post", level = 0.95)
  
  result <- c(
    att = as.numeric(b[["treat_post"]]),
    se  = as.numeric(s[["treat_post"]]),
    lo  = as.numeric(ci[1, 1]),
    hi  = as.numeric(ci[1, 2])
  )
  
  if (!all(is.finite(result))) {
    stop("Non-finite ATT result for outcome: ", y)
  }
  
  result
}


# Joint test of pre-treatment event-study coefficients.
# Returns NA when the test cannot be estimated.

pre_p <- function(y, d) {
  
  formula_es <- as.formula(
    paste0(
      y,
      " ~ i(event_time, treated, ref = ",
      ref_year - onset,
      ") | pixel_id + year"
    )
  )
  
  model <- feols(
    formula_es,
    data = d,
    cluster = ~cluster
  )
  
  result <- tryCatch(
    wald(
      model,
      keep = "event_time::-[2-9][0-9]*:treated",
      print = FALSE
    ),
    error = function(e) NULL
  )
  
  # Fallback for the common fixest coefficient naming pattern.
  if (is.null(result)) {
    result <- tryCatch(
      wald(
        model,
        keep = "event_time::-[2-9]:treated",
        print = FALSE
      ),
      error = function(e) NULL
    )
  }
  
  if (is.null(result)) return(NA_real_)
  
  p <- result$p
  
  if (is.null(p) || !length(p)) return(NA_real_)
  
  as.numeric(p[1])
}


# Pre-treatment slope of the treated-minus-comparison mean gap.

pre_gap_slope <- function(y, d) {
  
  g <- d[year < onset,
         .(m = mean(get(y), na.rm = TRUE)),
         by = .(year, treated)]
  
  g <- dcast(g, year ~ treated, value.var = "m")
  
  if (!all(c("0", "1") %in% names(g)) || nrow(g) < 2L) {
    return(NA_real_)
  }
  
  g[, gap := `1` - `0`]
  
  as.numeric(coef(lm(gap ~ year, data = g))[["year"]])
}


# Pixel-specific pre-treatment slopes.
# Treatment status is attached from the unique pixel table.

pixel_slopes <- function(y) {
  
  S <- D[
    year < onset,
    {
      x <- get(y)
      ok <- is.finite(x) & is.finite(year)
      
      slope <- if (sum(ok) >= 3L &&
                   var(year[ok]) > 0) {
        cov(year[ok], x[ok]) / var(year[ok])
      } else {
        NA_real_
      }
      
      .(sl = as.numeric(slope))
    },
    by = pixel_id
  ]
  
  S <- merge(
    S,
    P,
    by = "pixel_id",
    all.x = TRUE,
    sort = FALSE
  )
  
  S[]
}


# Identify outlying pixel slopes using a median/MAD rule.
# If MAD is zero or undefined, that group is not filtered.

drop_ids <- function(S, metric, k) {
  
  S <- copy(S[is.finite(sl)])
  
  if (!nrow(S)) return(S$pixel_id)
  
  if (metric == "slope_pooled") {
    
    center <- median(S$sl, na.rm = TRUE)
    spread <- mad(S$sl, center = center, na.rm = TRUE)
    
    if (!is.finite(spread) || spread <= 0) {
      return(S$pixel_id[0])
    }
    
    return(unique(
      S[abs(sl - center) > k * spread, pixel_id]
    ))
  }
  
  if (metric == "slope_group") {
    
    S[, `:=`(
      center = median(sl, na.rm = TRUE),
      spread = mad(sl, na.rm = TRUE)
    ), by = treated]
    
    S[, z := fifelse(
      is.finite(spread) & spread > 0,
      abs(sl - center) / spread,
      NA_real_
    )]
    
    return(unique(S[z > k, pixel_id]))
  }
  
  stop("Unknown filtering metric: ", metric)
}


