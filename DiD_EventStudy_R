# 9. PARALLEL TRENDS TEST
# Joint F-test on pre-treatment coefficients k=-4,-3,-2
# ------------------------------------------------------------
cat("\n=== Parallel Trends Tests ===\n")

test_pt <- function(model, outcome) {
  
  coef_names <- names(coef(model))
  pre_terms  <- grep(
    "event_time::-[432]",
    coef_names,
    value = TRUE
  )
  
  if(length(pre_terms) == 0) {
    cat(outcome, ": No pre-treatment terms found\n")
    return(NULL)
  }
  
  jt <- wald(model, keep = pre_terms)
  
  cat(outcome, "- Joint F-test on k=-4,-3,-2:\n")
  cat("  F =", round(jt$stat, 3),
      "| p =", round(jt$p, 4))
  cat(ifelse(jt$p > 0.05,
             " ✅ PASS\n",
             " ❌ FAIL\n"))
  return(jt)
}

