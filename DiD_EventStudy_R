cat("\n=== Wild Cluster Bootstrap ===\n")

run_wcb <- function(model, outcome, B = 999) {
  cat(outcome, "- Wild cluster bootstrap (B =", B, "):\n")
  
  tryCatch({
    wb <- boottest(
      model,
      clustid     = "climate_grid_id",
      param       = "treat_post",
      B           = B,
      type        = "rademacher",
      impose_null = TRUE
    )
    cat("  p-value:", round(wb$p_val, 4), "\n")
    cat("  95% CI: [",
        round(wb$conf_int[1], 4), ",",
        round(wb$conf_int[2], 4), "]\n")
    return(wb)
  }, error = function(e) {
    cat("  Bootstrap failed:", e$message, "\n")
    return(NULL)
  })
}

