cat("\n=== Placebo Permutation Tests ===\n")

run_placebo <- function(outcome, data, n_perm = 500) {
  set.seed(2024)
  
  obs_model <- feols(
    as.formula(paste0(
      outcome, "_anom ~ treat_post + ",
      CLIMATE_COVARS,
      " | pixel_id + year"
    )),
    data    = data,
    cluster = ~climate_grid_id
  )
  
  obs_att <- coef(obs_model)[["treat_post"]]
  
  if(is.na(obs_att)) {
    stop(paste("ATT not found for", outcome))
  }
  
  cat(outcome, "- Running", n_perm, "permutations...\n")
  
  perm_atts <- numeric(n_perm)
  
  for(i in seq_len(n_perm)) {
    
    perm_pixels <- data %>%
      distinct(pixel_id, treated) %>%
      mutate(treated_perm = sample(treated, size = n(), replace = FALSE))
    
    perm_data <- data %>%
      left_join(
        perm_pixels %>% select(pixel_id, treated_perm),
        by = "pixel_id"
      ) %>%
      mutate(treat_post = treated_perm * post)
    
    perm_model <- feols(
      as.formula(paste0(
        outcome, "_anom ~ treat_post + ",
        CLIMATE_COVARS,
        " | pixel_id + year"
      )),
      data    = perm_data,
      cluster = ~climate_grid_id
    )
    
    perm_atts[i] <- coef(perm_model)[["treat_post"]]
  }
  
  # ✅ Corrected p-value
  p_val <- (sum(abs(perm_atts) >= abs(obs_att)) + 1) / (n_perm + 1)
  
  cat("  Observed ATT:", round(obs_att, 4), "\n")
  cat("  Permutation p:", round(p_val, 4), "\n")
  
  list(
    outcome      = outcome,
    observed_att = obs_att,
    placebo_dist = perm_atts,
    p_value      = p_val
  )
}

