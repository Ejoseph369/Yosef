function annualNDVI(year) {

  year =
      ee.Number(year);

  var start =
      ee.Date.fromYMD(
        year,
        1,
        1
      );

  var end =
      start.advance(
        1,
        'year'
      );

  return NDVI
    .filterDate(
      start,
      end
    )
    .filterBounds(roi)
    .select('NDVI')
    .mean()
    .multiply(0.0001)
    .rename('NDVI')
    .set(
      'year',
      year
    );
}


// ============================================================================
// 8. ANNUAL ET — FIXED
// ============================================================================
//
// 2015–2020 → MOD16A2GF
// 2021–2025 → MOD16A2
//
// Both products have ET in kg m-2 per composite period.
// Numerically this is equivalent to mm for water depth.
// Scale factor = 0.1.
//
// ============================================================================

function annualET(year) {

  year =
      ee.Number(year);

  var start =
      ee.Date.fromYMD(
        year,
        1,
        1
      );

  var end =
      start.advance(
        1,
        'year'
      );


  // Historical gap-filled product
  var historical =
      ET_GF
        .filterDate(
          start,
          end
        )
        .filterBounds(roi)
        .select('ET');


  // Current product
  var current =
      ET_CURRENT
        .filterDate(
          start,
          end
        )
        .filterBounds(roi)
        .select('ET');


  // Select appropriate collection
  var selected =
      ee.ImageCollection(
        ee.Algorithms.If(
          year.lte(2020),
          historical,
          current
        )
      );


  return selected
    .map(
      function(img) {

        return img
          .multiply(0.1)
          .copyProperties(
            img,
            ['system:time_start']
          );
      }
    )
    .sum()
    .rename('ET')
    .set(
      'year',
      year
    );
}


