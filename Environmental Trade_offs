function treatmentFraction(
    targetProjection,
    name
) {

  return candidateTreatment
    .setDefaultProjection(
      candidateTreatment
        .projection()
    )
    .reduceResolution({
      reducer:
        ee.Reducer.mean(),

      maxPixels:
        4096
    })
    .reproject(
      targetProjection
    )
    .rename(name);
}


