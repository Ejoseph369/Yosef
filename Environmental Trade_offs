var years =
    ee.List.sequence(
      2015,
      2025
    );


var annualCollection =
    ee.ImageCollection.fromImages(

      years.map(
        function(year) {

          var ndvi =
              annualNDVI(year);

          var et =
              annualET(year);

          var lst =
              annualLST(year);

          var albedo =
              annualAlbedo(year);

          var p =
              annualP(year);

          var pet =
              annualPET(year);


          // WBP = ET - P
          var wbp =
              et
                .subtract(p)
                .rename('WBP');


          // EI = ET / P
          var ei =
              et
                .divide(
                  p.max(1)
                )
                .rename('EI');


          // AI = PET / P
          var ai =
              pet
                .divide(
                  p.max(1)
                )
                .rename('AI');


          return ee.Image.cat([
            ndvi,
            et,
            lst,
            albedo,
            p,
            pet,
            wbp,
            ei,
            ai
          ])
          .set(
            'year',
            year
          )
          .clip(roi);
        }
      )
    );


