// ============================================================================
// 12. FAO PENMAN–MONTEITH PET
// ============================================================================

var U10_TO_U2 =
    4.87 /
    Math.log(
      67.8 * 10 - 5.42
    );


function saturationVaporPressure(
    Tc
) {

  return Tc.expression(
    '0.6108 * exp((17.27*T)/(T+237.3))',
    {
      T: Tc
    }
  );
}


function deltaVaporPressure(
    Tc
) {

  var es =
      saturationVaporPressure(
        Tc
      );

  return es.expression(
    '4098*es/pow(T+237.3,2)',
    {
      es: es,
      T: Tc
    }
  );
}


// -----------------------------------------------------------------------------
// Monthly FAO-PM
// -----------------------------------------------------------------------------

function monthlyFAOPM(img) {

  var T =
      img
        .select(
          'temperature_2m'
        )
        .subtract(273.15);


  var Td =
      img
        .select(
          'dewpoint_temperature_2m'
        )
        .subtract(273.15);


  var es =
      saturationVaporPressure(
        T
      );


  var ea =
      saturationVaporPressure(
        Td
      );


  var vpd =
      es
        .subtract(ea)
        .max(0);


  var delta =
      deltaVaporPressure(
        T
      );


  var pressureKPa =
      img
        .select(
          'surface_pressure'
        )
        .divide(1000);


  var gamma =
      pressureKPa
        .multiply(0.000665);


  var u10 =
      img
        .select(
          'u_component_of_wind_10m'
        )
        .pow(2)
        .add(
          img
            .select(
              'v_component_of_wind_10m'
            )
            .pow(2)
        )
        .sqrt();


  var u2 =
      u10.multiply(
        U10_TO_U2
      );


  var date =
      ee.Date(
        img.get(
          'system:time_start'
        )
      );


  var nextDate =
      date.advance(
        1,
        'month'
      );


  var days =
      nextDate.difference(
        date,
        'day'
      );


  // Net radiation
  var Rn_month =
      img
        .select(
          'surface_net_solar_radiation_sum'
        )
        .add(
          img.select(
            'surface_net_thermal_radiation_sum'
          )
        )
        .divide(1e6);


  var Rn_daily =
      Rn_month.divide(
        days
      );


  var numerator =
      delta
        .multiply(0.408)
        .multiply(
          Rn_daily
        )
        .add(
          gamma
            .multiply(900)
            .divide(
              T.add(273.15)
            )
            .multiply(u2)
            .multiply(vpd)
        );


  var denominator =
      delta.add(
        gamma.multiply(
          ee.Image.constant(1)
            .add(
              u2.multiply(0.34)
            )
        )
      );


  var ET0_daily =
      numerator
        .divide(
          denominator
        )
        .max(0);


  var PET_month =
      ET0_daily
        .multiply(days)
        .rename('PET');


  return PET_month
    .copyProperties(
      img,
      ['system:time_start']
    );
}


// -----------------------------------------------------------------------------
// Annual PET
// -----------------------------------------------------------------------------

function annualPET(year) {

  year =
      ee.Number(year);

  var start =
      ee.Date.fromYMD(
        year,
        1,
        1
      );

  var end =
      start.advance(
        1,
        'year'
      );


  var monthly =
      ERA5L
        .filterDate(
          start,
          end
        )
        .filterBounds(roi);


  return monthly
    .map(
      monthlyFAOPM
    )
    .sum()
    .rename('PET')
    .set(
      'year',
      year
    );
}


