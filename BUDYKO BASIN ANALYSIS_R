  )

metrics <- metric_data %>%
  summarise(
    R = if (n() >= 2) {
      cor(et_ratio_Pre, et_pred_pre)
    } else {
      NA_real_
    },
    
    R2 = R^2,
    
    RMSE = sqrt(
      mean((et_ratio_Pre - et_pred_pre)^2)
    ),
    
    N = n()
  )

