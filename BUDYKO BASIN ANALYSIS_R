budyko_curves <- data.frame(
  phi = phi_seq,
  
  Fu_median = fu_equation(phi_seq, median_w),
  
  Fu_low = pmin(
    fu_equation(phi_seq, w_q25),
    fu_equation(phi_seq, w_q75)
  ),
  
  Fu_high = pmax(
    fu_equation(phi_seq, w_q25),
    fu_equation(phi_seq, w_q75)
  ),
  
  Budyko1974 = budyko_1974(phi_seq),
  
  Zhang_median = zhang_fun(phi_seq, median_w)
)

