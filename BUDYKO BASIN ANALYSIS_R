# ===============================
# 6. BUDYKO FUNCTIONS
# ===============================

# Fu equation
fu_equation <- function(phi, w) {
  1 + phi - (1 + phi^w)^(1 / w)
}

# Zhang equation
zhang_fun <- function(phi, w) {
  (1 + w * phi) /
    (1 + w * phi + 1 / phi)
}

# Standard Budyko (1974) curve
budyko_1974 <- function(phi) {
  phi * tanh(1 / phi) *
    (1 - exp(-phi))^0.5
}

# ===============================
# 7. ESTIMATE BASIN-SPECIFIC OMEGA
# ===============================
estimate_w_fu <- function(phi, et) {
  
  if (
    !is.finite(phi) ||
    !is.finite(et) ||
    phi <= 0 ||
    et < 0 ||
    et > 1 + 1e-8
  ) {
    return(NA_real_)
  }
  
  objective <- function(w) {
    fu_equation(phi, w) - et
  }
  
  tryCatch({
    
    lo <- 0.1
    hi <- 10
    
    if (objective(lo) * objective(hi) > 0) {
      return(NA_real_)
    }
    
    uniroot(
      objective,
      lower = lo,
      upper = hi,
      tol = 1e-7
    )$root
    
  }, error = function(e) NA_real_)
}


estimate_w_zhang <- function(phi, et) {
  
  if (
    !is.finite(phi) ||
    !is.finite(et) ||
    phi <= 0 ||
    et < 0 ||
    et > 1 + 1e-8
  ) {
    return(NA_real_)
  }
  
  objective <- function(w) {
    zhang_fun(phi, w) - et
  }
  
  tryCatch({
    
    lo <- 0.1
    hi <- 20
    
    if (objective(lo) * objective(hi) > 0) {
      return(NA_real_)
    }
    
    uniroot(
      objective,
      lower = lo,
      upper = hi,
      tol = 1e-7
    )$root
    
  }, error = function(e) NA_real_)
}

# ===============================
# 8. PRE/POST OMEGA ESTIMATION
# ===============================
omega_df <- basin_shift %>%
  rowwise() %>%
  mutate(
    pre_w = estimate_w_fu(phi_Pre, et_ratio_Pre),
    post_w = estimate_w_fu(phi_Post, et_ratio_Post),
    delta_w = post_w - pre_w,
    
    pre_w_zhang = estimate_w_zhang(
      phi_Pre, et_ratio_Pre
    ),
    
    post_w_zhang = estimate_w_zhang(
      phi_Post, et_ratio_Post
    ),
    
    delta_w_zhang = post_w_zhang - pre_w_zhang
  ) %>%
  ungroup()

