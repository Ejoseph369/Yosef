# FIGURE 3 — WATER TRADE-OFF
# =========================================
# ===============================
panel_file <- "I:/Afforestation_Analysis/DiD_EventStudy_Panel_FINAL (done2).csv"
onset <- 2019
ref_year <- 2018                      # event-study reference year (k = -1), as in Fig. 3

df <- fread(panel_file) %>%
  mutate(year = as.integer(year), treated = as.integer(treated),
         WB = ET - P_mm, CWD = PET - ET) %>%
  filter(year >= 2015)

# ---------------------------------------------------------------------------
yr <- df %>%
  group_by(year, treated) %>%
  summarise(across(c(ET, P_mm, WB), list(m = ~mean(.x, na.rm = TRUE),
                                         v = ~var(.x, na.rm = TRUE)),
                   .names = "{.col}_{.fn}"),
            n = n(), .groups = "drop") %>%
  pivot_wider(names_from = treated, values_from = c(ET_m, ET_v, P_mm_m, P_mm_v, WB_m, WB_v, n))

gap <- yr %>%
  transmute(year,
            gap_ET = ET_m_1 - ET_m_0,
            gap_P  = P_mm_m_1 - P_mm_m_0,
            gap_WB = WB_m_1 - WB_m_0,
            # naive SE of each gap (ignores spatial clustering; model SEs are below)
            se_ET = sqrt(ET_v_1 / n_1 + ET_v_0 / n_0),
            se_WB = sqrt(WB_v_1 / n_1 + WB_v_0 / n_0))

# ---------------------------------------------------------------------------
# 2. The reconciliation table (what the numbers in Section 3.3 are)
# ---------------------------------------------------------------------------
pre  <- gap %>% filter(year <  onset)
post <- gap %>% filter(year >= onset)
tab <- data.frame(
  quantity = c("ET gap (treated - control)", "P gap (treated - control)", "WBP gap (treated - control)"),
  pre_mean  = c(mean(pre$gap_ET),  mean(pre$gap_P),  mean(pre$gap_WB)),
  post_mean = c(mean(post$gap_ET), mean(post$gap_P), mean(post$gap_WB)))
tab$change_post_minus_pre <- tab$post_mean - tab$pre_mean      # simple DiD of the gaps
tab$pct_of_pre_gap <- 100 * tab$change_post_minus_pre / abs(tab$pre_mean)
print(tab, digits = 4)
cat("\nIdentity check (WBP = ET - P): change_ET - change_P =",
    round(tab$change_post_minus_pre[1] - tab$change_post_minus_pre[2], 2),
    "| change_WBP =", round(tab$change_post_minus_pre[3], 2), "\n")

# DiD series by year, two normalisations
base_mean <- mean(pre$gap_WB); base_ref <- gap$gap_WB[gap$year == ref_year]
gap <- gap %>% mutate(
  did_ET_premean = gap_ET - mean(pre$gap_ET), did_ET_ref = gap_ET - gap_ET[year == ref_year],
  did_WB_premean = gap_WB - base_mean,        did_WB_ref = gap_WB - base_ref)
cat("\nPeak post-2019 DiD (pre-mean baseline): ET =", round(max(gap$did_ET_premean[gap$year >= onset]), 1),
    "| WBP =", round(max(gap$did_WB_premean[gap$year >= onset]), 1), "\n")
cat("Mean post-2019 DiD (pre-mean baseline): ET =", round(mean(gap$did_ET_premean[gap$year >= onset]), 1),
    "| WBP =", round(mean(gap$did_WB_premean[gap$year >= onset]), 1), "\n")
cat("Pre-period mean of the pre-mean-normalised series is exactly",
    round(mean(gap$did_WB_premean[gap$year < onset]), 10),
    "so a percent change computed from it divides by zero.\n")

# ---------------------------------------------------------------------------
# 3. Model-based event study with clustered SEs (same logic as Fig. 3)
#    Adjust pixel_id / cluster_id to the column names in your panel file.
# ---------------------------------------------------------------------------
if (all(c("pixel_id", "cluster_id") %in% names(df))) {
  es <- function(y) {
    m <- feols(as.formula(paste(y, "~ i(year, treated, ref =", ref_year, ") | pixel_id + year")),
               data = df, cluster = ~cluster_id)
    ct <- as.data.table(coeftable(m), keep.rownames = "term")
    setnames(ct, c("term", "est", "se", "t", "p"))
    ct[, year := as.integer(sub(".*::([0-9]{4}).*", "\\1", term))]
    ct[, `:=`(lo = est - 1.96 * se, hi = est + 1.96 * se)]
    ct[]
  }
  es_ET <- es("ET"); es_WB <- es("WB"); es_P <- es("P_mm")
  print(es_WB[year >= onset])
} 

# ---------------------------------------------------------------------------
# 4. Panels (a) and (b); label (b) as the DiD-adjusted WBP change
# ---------------------------------------------------------------------------
panel <- function(d, y, lo, hi, title, ylab) {
  ggplot(d, aes(year, .data[[y]])) +
    annotate("rect", xmin = onset, xmax = max(d$year), ymin = -Inf, ymax = Inf, fill = "grey97") +
    geom_vline(xintercept = onset, linetype = "dashed", colour = "grey40") +
    geom_hline(yintercept = 0, linetype = "dashed", colour = "grey60") +
    geom_ribbon(aes(ymin = .data[[lo]], ymax = .data[[hi]]), fill = "grey30", alpha = 0.25) +
    geom_line(colour = "blue", linewidth = 1.2) + geom_point(colour = "blue", size = 2.3) +
    scale_x_continuous(breaks = sort(unique(d$year))) +
    labs(title = title, y = ylab, x = "Year") +
    theme_minimal(base_size = 13) + theme(plot.title.position = "plot")
}
if (exists("es_ET")) {
  pa <- panel(es_ET, "est", "lo", "hi", "(a)", expression(Delta*ET~(mm~yr^{-1})))
  pb <- panel(es_WB, "est", "lo", "hi", "(b)", "DiD-adjusted ΔWBP (mm/yr)")
  print(pa | pb)   # needs library(patchwork)
}


# ===============================
# 2. YEARLY SUMMARY (MEAN + SE)
# ===============================
df_year <- df %>%
  group_by(year, treated) %>%
  summarise(
    ET  = mean(ET, na.rm = TRUE),
    ET_sd = sd(ET, na.rm = TRUE),
    
    
    WB  = mean(WB, na.rm = TRUE),
    WB_sd = sd(WB, na.rm = TRUE),
    
    .groups = "drop"
  )

# ===============================
# 3. TREATED – CONTROL DIFFERENCE
# ===============================
df_diff <- df_year %>%
  pivot_wider(
    names_from = treated,
    values_from = c(ET,  WB, ET_sd, WB_sd)
  ) %>%
  mutate(
    # Raw differences
    dET  = ET_1  - ET_0,
    dWB  = WB_1  - WB_0,
    
    # Standard errors of differences
    se_dET  = sqrt(ET_sd_1^2  + ET_sd_0^2),
    se_dWB  = sqrt(WB_sd_1^2  + WB_sd_0^2)
  )

# ===============================
# 4. DiD NORMALIZATION (CRITICAL FIX)
# ===============================
baseline <- df_diff %>%
  filter(year < 2019) %>%
  summarise(
    bET  = mean(dET, na.rm = TRUE),
    bWB  = mean(dWB, na.rm = TRUE)
  )

df_diff <- df_diff %>%
  mutate(
    # Difference-in-differences (causal effects)
    dET_did  = dET  - baseline$bET,
    dWB_did  = dWB  - baseline$bWB,
    
    # 95% CI (unchanged SE, centered on DiD)
    dET_lo  = dET_did  - 1.96 * se_dET,
    dET_hi  = dET_did  + 1.96 * se_dET,
    
    dWB_lo  = dWB_did  - 1.96 * se_dWB,
    dWB_hi  = dWB_did  + 1.96 * se_dWB,
  )

