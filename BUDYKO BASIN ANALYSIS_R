plot_clean <- function(data, y, ymin, ymax, title, ylab, threshold = NULL) {
  
  ggplot(data, aes(year, {{y}})) +
    
    # Post-treatment shading
    annotate("rect", xmin = 2019, xmax = max(data$year),
             ymin = -Inf, ymax = Inf,
             fill = "grey97") +
    
    # Reference lines
    geom_vline(xintercept = 2019,
               linetype = "dashed",
               color = "grey40",
               linewidth = 0.5) +
    
    geom_hline(yintercept = 0,
               linetype = "dashed",
               color = "grey60",
               linewidth = 0.4) +
    
    # Optional threshold
    {if (!is.null(threshold))
      geom_hline(yintercept = threshold,
                 linetype = "longdash",
                 color = "black",
                 linewidth = 0.6)
    } +
    
    # 🔥 Visible CI ribbon
    geom_ribbon(
      aes(ymin = {{ymin}}, ymax = {{ymax}}, group = 1),
      fill = "grey7",
      alpha = 0.25
    ) +
    
    # Main signal
    geom_line(linewidth = 1.2, color = "blue") +
    geom_point(size = 2.3, color = "blue") +
    
    scale_x_continuous(breaks = sort(unique(data$year))) +
    
    labs(
      title = title,
      y = ylab,
      x = "Year"
    ) +
    
    theme_pub +theme(
      plot.title = element_text(
        hjust = 0,
        face = "bold",
        size = 16
      ),
      plot.title.position = "plot"
    )
  
}

