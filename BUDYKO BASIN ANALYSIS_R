# 1. FUNCTION TO COMPUTE STATS
get_stats <- function(df, yvar) {
  model <- lm(df[[yvar]] ~ df$year)
  r2 <- summary(model)$r.squared
  r  <- cor(df[[yvar]], df$year, use = "complete.obs")
  
  list(
    label = paste0("R = ", sprintf("%.2f", r),
                   "\nR² = ", sprintf("%.2f", r2))
  )
}

plot_p_context <- function(data) {
  
  stats <- get_stats(data, "P")
  
  y_min <- min(data$P, na.rm = TRUE)
  y_max <- max(data$P, na.rm = TRUE)
  
  ggplot(data, aes(year, P)) +
    
    annotate("rect", xmin = 2019, xmax = 2025,
             ymin = -Inf, ymax = Inf,
             fill = "grey97") +
    
    geom_vline(xintercept = 2019,
               linetype = "dashed",
               color = "grey40",
               linewidth = 0.4) +
    
    geom_ribbon(
      aes(ymin = P_lo, ymax = P_hi),
      fill = "dodgerblue",
      alpha = 0.25
    ) +
    
    geom_line(color = "blue", linewidth = 1) +
    geom_point(size = 2, color = "blue") +
    
    scale_x_continuous(breaks = 2015:2025) +
    
    labs(
      title = "(d)",
