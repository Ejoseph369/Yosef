    names_to = "curve",
    values_to = "value"
  ) %>%
  mutate(
    curve = recode(
      curve,
      Fu_median = "Fu curve",
      Budyko1974 = "Budyko (1974)",
      Zhang_median = "Zhang curve"
    )
  )

