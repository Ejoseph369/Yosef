    "Predictive R-squared (1 - SSE/SST)",
    "Calibration intercept: observed ~ predicted",
    "Calibration slope: observed ~ predicted",
    "Calibration slope 95% CI lower",
    "Calibration slope 95% CI upper",
    "MAPE (%)"
  ),
  value = c(
    n, mean_obs, mean_pred, rmse, mae, bias, pearson_r,
    r_squared_correlation, r2_predictive, intercept, slope,
    slope_ci[1], slope_ci[2], mape
  )
)

