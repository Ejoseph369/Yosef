# -----------------------------
# 6. Independent validation metrics
# -----------------------------
obs  <- validation$field_agb
pred <- validation$rf_agb
resid <- pred - obs
n <- length(obs)

rmse <- sqrt(mean(resid^2))
mae  <- mean(abs(resid))
bias <- mean(resid)   # RF − field
mean_obs  <- mean(obs)
mean_pred <- mean(pred)

pearson_r <- if (sd(obs) > 0 && sd(pred) > 0) cor(obs, pred) else NA_real_
r_squared_correlation <- pearson_r^2

r2_predictive <- if (sum((obs - mean(obs))^2) > 0) {
  1 - sum((pred - obs)^2) / sum((obs - mean(obs))^2)
} else {
  NA_real_
}

calibration_model <- lm(obs ~ pred)
intercept <- unname(coef(calibration_model)[1])
slope     <- unname(coef(calibration_model)[2])
slope_ci  <- tryCatch(
  unname(confint(calibration_model, "pred", level = 0.95)),
  error = function(e) c(NA_real_, NA_real_)
)

mape <- if (all(obs != 0)) mean(abs((pred - obs) / obs)) * 100 else NA_real_

metrics <- tibble::tibble(
  metric = c(
    "Number of matched validation plots",
    "Mean observed field AGB (Mg ha-1)",
    "Mean RF-predicted AGB (Mg ha-1)",
    "RMSE (Mg ha-1)",
    "MAE (Mg ha-1)",
    "Bias: RF prediction minus field observation (Mg ha-1)",
    "Pearson correlation (r)",
