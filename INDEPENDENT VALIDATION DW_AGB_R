# -----------------------------
# 3. Column-name helpers (Windows-safe)
# -----------------------------
normalize_name <- function(x) {
  x <- as.character(x)
  x <- iconv(x, from = "", to = "UTF-8", sub = "")
  x[is.na(x)] <- ""
  x <- iconv(x, from = "UTF-8", to = "ASCII//TRANSLIT", sub = "")
  x[is.na(x)] <- ""
  x <- tolower(x)
  gsub("[^[:alnum:]]", "", x, perl = FALSE)
}

find_column <- function(data, candidates, description) {
  nm <- names(data)
  nm_norm <- normalize_name(nm)
  cand_norm <- normalize_name(candidates)
  
  idx <- match(cand_norm, nm_norm, nomatch = 0L)
  idx <- idx[idx > 0L]
  if (length(idx) > 0L) return(nm[idx[1]])
  
  for (candidate in cand_norm) {
    if (!nzchar(candidate)) next
    hits <- which(grepl(candidate, nm_norm, fixed = TRUE))
    if (length(hits) == 1L) return(nm[hits])
  }
  
  stop(
    "Could not automatically identify the ", description, " column.\n",
    "Available columns: ", paste(nm, collapse = ", "), "\n",
    "Set field_id_col / rf_id_col / field_agb_col / rf_agb_col manually below."
  )
}

