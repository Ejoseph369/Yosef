classify_beta3 <- function(est, lo, hi) {
  if (is.na(est) || is.na(lo) || is.na(hi)) return("insufficient data")
  if (lo > 0) return("confident-gain")
  if (hi < 0) return("confident-loss")
  return("no-detectable-change")
}

