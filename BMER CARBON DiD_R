# ----------------------------------------------------------------
# 18. LEAVE-ONE-YEAR-OUT (LOYO) TEMPORAL SENSITIVITY ANALYSIS
# ----------------------------------------------------------------
# Purpose:
#   Assess whether the primary TWFE DiD treatment effect (β3)
#   is disproportionately driven by any single calendar year.
#
# Study period:
#   2015–2025
#
# Intervention:
#   2019
#
# Pre-intervention period:
#   2015–2018
#
# Post-intervention period:
#   2019–2025
#
# Each LOYO specification removes exactly one calendar year while
# retaining observations from both the pre- and post-intervention
# periods. The primary DiD formula, fixed effects, covariates,
# and clustering structure are kept unchanged.
# ----------------------------------------------------------------

cat("\n============================================================\n")
cat("LEAVE-ONE-YEAR-OUT (LOYO) TEMPORAL SENSITIVITY ANALYSIS\n")
cat("============================================================\n")

# ----------------------------------------------------------------
# 18.1 DEFINE THE LOYO ANALYSIS WINDOW
# ----------------------------------------------------------------

loyo_start_year <- 2015
loyo_end_year   <- 2025
intervention_year <- 2019

analysis_loyo <- analysis_matched %>%
  filter(
    year >= loyo_start_year,
    year <= loyo_end_year
  )

# Verify required variables
required_loyo_vars <- c(
  "year",
  "spatial_unit",
  "treatment",
  "post"
)

missing_loyo_vars <- setdiff(
  required_loyo_vars,
  names(analysis_loyo)
)

if (length(missing_loyo_vars) > 0) {
  
  stop(
    paste(
      "LOYO analysis cannot proceed. Missing variables:",
      paste(missing_loyo_vars, collapse = ", ")
    )
  )
}

# ----------------------------------------------------------------
# 18.2 VERIFY THE PRE/POST STRUCTURE
# ----------------------------------------------------------------

pre_years <- sort(unique(
  analysis_loyo$year[
    analysis_loyo$year < intervention_year
  ]
))

post_years <- sort(unique(
  analysis_loyo$year[
    analysis_loyo$year >= intervention_year
  ]
))

cat("\nLOYO analysis period:\n")
cat(
  "  Years:",
  loyo_start_year,
  "to",
  loyo_end_year,
  "\n"
)

cat(
  "  Pre-intervention:",
  paste(pre_years, collapse = ", "),
  "\n"
)

cat(
  "  Post-intervention:",
  paste(post_years, collapse = ", "),
  "\n"
)

if (length(pre_years) < 2) {
  
  stop(
    "Insufficient pre-intervention years for LOYO analysis."
  )
}

if (length(post_years) < 2) {
  
  stop(
    "Insufficient post-intervention years for LOYO analysis."
  )
}

# ----------------------------------------------------------------
# 18.3 LEAVE-ONE-YEAR-OUT ESTIMATION
# ----------------------------------------------------------------

years_available <- sort(
  unique(analysis_loyo$year)
)

loyo_results <- vector(
  "list",
  length(years_available)
)

names(loyo_results) <- as.character(
  years_available
)

for (yr in years_available) {
  
  cat("\nDropping year:", yr, "\n")
  
  # --------------------------------------------------------------
  # Remove one calendar year
  # --------------------------------------------------------------
  
  dat_loyo <- analysis_loyo %>%
    filter(year != yr)
  
  # --------------------------------------------------------------
  # Check that both pre- and post-intervention periods remain
  # --------------------------------------------------------------
  
  pre_remaining <- sort(unique(
    dat_loyo$year[
      dat_loyo$year < intervention_year
    ]
  ))
  
  post_remaining <- sort(unique(
    dat_loyo$year[
      dat_loyo$year >= intervention_year
    ]
  ))
  
  if (
    length(pre_remaining) == 0 ||
    length(post_remaining) == 0
  ) {
    
    warning(
      paste(
        "Skipping year",
        yr,
        ": one intervention period is missing."
      )
    )
    
    next
  }
  
  # --------------------------------------------------------------
  # Re-estimate the EXACT primary TWFE DiD model
  # --------------------------------------------------------------
  
  mod_loyo <- tryCatch(
    
    feols(
      did_fml2,
      data = dat_loyo,
      cluster = as.formula(
        paste0("~", cluster_var)
      )
    ),
    
    error = function(e) {
      
      warning(
        paste(
          "LOYO model failed when dropping year",
          yr,
          ":",
          e$message
        )
      )
      
      NULL
    }
  )
  
  # --------------------------------------------------------------
  # Extract treatment × post coefficient
  # --------------------------------------------------------------
  
  if (!is.null(mod_loyo)) {
    
    coef_loyo <- broom::tidy(
      mod_loyo,
      conf.int = TRUE
    ) %>%
      filter(
        term == "treatment:post"
      )
    
    if (nrow(coef_loyo) > 0) {
      
      beta3_est <- coef_loyo$estimate[1]
      beta3_se  <- coef_loyo$std.error[1]
      beta3_p   <- coef_loyo$p.value[1]
      beta3_lo  <- coef_loyo$conf.low[1]
      beta3_hi  <- coef_loyo$conf.high[1]
      
    } else {
      
      beta3_est <- NA_real_
      beta3_se  <- NA_real_
      beta3_p   <- NA_real_
      beta3_lo  <- NA_real_
      beta3_hi  <- NA_real_
    }
    
  } else {
    
    beta3_est <- NA_real_
    beta3_se  <- NA_real_
    beta3_p   <- NA_real_
    beta3_lo  <- NA_real_
    beta3_hi  <- NA_real_
  }
  
  # --------------------------------------------------------------
  # Store results
  # --------------------------------------------------------------
  
  loyo_results[[as.character(yr)]] <- tibble(
    
    dropped_year = yr,
    
    n_obs = nrow(dat_loyo),
    
    n_units = n_distinct(
