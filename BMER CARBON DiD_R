cat("\n=== Spatial Bootstrap / Monte Carlo (n =", n_boot, ") ===\n")

# Helper: extract β₃ from a fitted model
get_beta3 <- function(mod) {
  coefs <- coef(mod)
  nm <- names(coefs)
  idx <- grep("treatment:post|treatment::post", nm)
  if (length(idx) == 0) return(NA_real_)
  as.numeric(coefs[idx[1]])
}

# Spatial units (or climate grids) to resample
boot_ids <- unique(analysis_matched[[cluster_var]])
boot_ids <- boot_ids[!is.na(boot_ids)]

beta3_boot   <- numeric(n_boot)
cre_star_boot <- numeric(n_boot)

set.seed(2026)
for (b in seq_len(n_boot)) {
  # Resample clusters with replacement
  sampled_ids <- sample(boot_ids, size = length(boot_ids), replace = TRUE)
  
  # Build bootstrap sample (keep all years of selected clusters)
  boot_dat <- analysis_matched %>%
    filter(.data[[cluster_var]] %in% sampled_ids)
  
  # --- DiD β₃ ---
  mod_b <- tryCatch(
    feols(did_fml2, data = boot_dat,
          cluster = as.formula(paste("~", cluster_var))),
    error = function(e) NULL
  )
  beta3_boot[b] <- if (!is.null(mod_b)) get_beta3(mod_b) else NA_real_
  
  # --- CRE* (simplified: mean CRE* of treated units in bootstrap sample) ---
  if (exists("cre_star_data") && "CRE_star" %in% names(cre_star_data)) {
    boot_units <- unique(boot_dat$spatial_unit[boot_dat$treatment == 1])
    cre_b <- cre_star_data %>%
      filter(spatial_unit %in% boot_units, treatment == 1, is.finite(CRE_star)) %>%
      pull(CRE_star)
    cre_star_boot[b] <- if (length(cre_b) > 0) mean(cre_b, na.rm = TRUE) else NA_real_
  } else {
    cre_star_boot[b] <- NA_real_
  }
  
  if (b %% 100 == 0) cat("Bootstrap iteration", b, "done\n")
}

# Summarise bootstrap results
boot_summary <- tibble(
  statistic = c("beta3", "CRE_star_mean"),
  mean      = c(mean(beta3_boot, na.rm = TRUE), mean(cre_star_boot, na.rm = TRUE)),
  median    = c(median(beta3_boot, na.rm = TRUE), median(cre_star_boot, na.rm = TRUE)),
  sd        = c(sd(beta3_boot, na.rm = TRUE), sd(cre_star_boot, na.rm = TRUE)),
  p2.5      = c(quantile(beta3_boot, 0.025, na.rm = TRUE),
                quantile(cre_star_boot, 0.025, na.rm = TRUE)),
  p97.5     = c(quantile(beta3_boot, 0.975, na.rm = TRUE),
