# SECTION 3.5 – ENVIRONMENTAL HETEROGENEITY FOREST PLOT
# Class-specific treatment × post effects with 95% CIs
# ================================================================

library(dplyr)
library(ggplot2)
library(broom)
library(stringr)

# ------------------------------------------------
# 1. Robust extractor for class-specific DiD effects
# ------------------------------------------------
extract_class_effects <- function(model, variable, labels, group_name) {
  
  b <- coef(model)
  V <- vcov(model)
  coef_names <- names(b)
  
  # Main treatment × post term (reference class)
  main_term <- grep("^treatment:post$|^treatment::post$", coef_names, value = TRUE)
  if (length(main_term) == 0) stop("Could not find treatment:post coefficient.")
  main_term <- main_term[1]
  
  # Helper: linear combination + variance
  get_effect <- function(terms) {
    terms <- terms[terms %in% coef_names]
    if (length(terms) == 0) {
      return(c(estimate = NA_real_, se = NA_real_,
               conf_low = NA_real_, conf_high = NA_real_))
    }
    estimate <- sum(b[terms])
    variance <- sum(V[terms, terms, drop = FALSE])   # 1' V 1
    se <- sqrt(max(variance, 0))
    c(estimate = estimate,
      se = se,
      conf_low = estimate - 1.96 * se,
      conf_high = estimate + 1.96 * se)
  }
  
  # Reference class (= first label)
  ref <- get_effect(main_term)
  out <- tibble(
    group    = group_name,
    class    = labels[1],
    estimate = ref["estimate"],
    se       = ref["se"],
    conf_low = ref["conf_low"],
    conf_high= ref["conf_high"]
  )
  
  # Other classes
  for (lab in labels[-1]) {
    # Possible name patterns produced by fixest
    patterns <- c(
      paste0("treatment:post:", variable, lab),
      paste0("treatment:post:", variable, ":", lab),
      paste0(variable, lab, ":treatment:post"),
      paste0(variable, ":", lab, ":treatment:post")
    )
    
    # Also try with the raw level name if labels were prettified
    term_to_use <- NULL
    for (pat in patterns) {
      hit <- grep(paste0("^", gsub("([()])", "\\\\\\1", pat), "$"), coef_names, value = TRUE)
      if (length(hit) > 0) {
        term_to_use <- hit[1]
        break
      }
    }
    
    # Fallback: any coefficient that contains both "treatment:post" and the level
    if (is.null(term_to_use)) {
      hit <- coef_names[str_detect(coef_names, "treatment:post") &
                          str_detect(coef_names, fixed(lab))]
      if (length(hit) > 0) term_to_use <- hit[1]
    }
    
    if (is.null(term_to_use)) {
      warning("Interaction term not found for ", variable, " = ", lab)
      next
    }
    
    res <- get_effect(c(main_term, term_to_use))
    out <- bind_rows(out, tibble(
      group    = group_name,
      class    = lab,
      estimate = res["estimate"],
      se       = res["se"],
      conf_low = res["conf_low"],
      conf_high= res["conf_high"]
    ))
  }
  out
}

