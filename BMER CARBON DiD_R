# ================================================================
# BMER CARBON DiD 
# # + Spatial Bootstrap / Monte Carlo
# + CRE* (standardized realization ratio)
# + Restoration Age × Environmental Heterogeneity
# ================================================================
#
# - Treatment = verified expansion patches
# - Control = areas remaining non-forest throughout
# - Matching = propensity-score + Mahalanobis on baseline covariates;
#   retain only common-support pairs
# - Primary model = TWFE DiD (Eq. 13)
# - Event time τ = t − Tᵢ (Tᵢ = first year unit satisfies expansion)
# - Pre-trend check → causal claim only if parallel trends hold
# - Clustering at climate-grid (fallback hierarchy)
# - Wild-cluster bootstrap robustness
# - Carbon Realization Efficiency (CRE) and standardized CRE*
# - Heterogeneity / driver exploration (hypotheses only)
# - Spatial bootstrap / Monte Carlo inference
# - Restoration age (2019 = age 0) × environmental interactions
#
# ================================================================
setwd("H:/My Drive/AGB")
# ----------------------------------------------------------------
# 0. PACKAGES
# ----------------------------------------------------------------
pkgs <- c(
  "tidyverse", "data.table", "fixest", "MatchIt", "cobalt",
  "broom", "modelsummary", "sandwich", "lmtest", "boot",
  "janitor", "stringr", "scales", "glue"
)
new <- pkgs[!(pkgs %in% installed.packages()[, "Package"])]
if (length(new)) install.packages(new)
invisible(lapply(pkgs, library, character.only = TRUE))
set.seed(2026)

# ----------------------------------------------------------------
# 1. USER SETTINGS
# ----------------------------------------------------------------
file_path <- "H:/My Drive/AGB/Balanced_DiD_Panel_2015_2025 (1).csv"
output_dir <- "BMER_DiD_Aligned"
if (!dir.exists(output_dir)) dir.create(output_dir, recursive = TRUE)

carbon_fraction   <- 0.47
intervention_year <- 2019          # policy start / restoration age = 0
start_year        <- 2015
end_year          <- 2025
pre_end           <- 2018          # last full pre year for matching / baseline
n_boot            <- 999           # spatial bootstrap / Monte Carlo iterations

# ----------------------------------------------------------------
# 2. IMPORT & STANDARDISE
# ----------------------------------------------------------------
dat <- read_csv(file_path, show_col_types = FALSE) %>% clean_names()

# Flexible renaming
nm <- names(dat)
if ("agb" %in% nm && !"agb_mg_ha" %in% nm) dat <- dat %>% rename(agb_mg_ha = agb)
if ("p_mm" %in% nm) dat <- dat %>% rename(precip_mm = p_mm)
if ("rootzone_sm" %in% nm) dat <- dat %>% rename(rootzone_soil_moisture = rootzone_sm)
if ("pixel_id" %in% nm && !"spatial_unit" %in% nm) dat <- dat %>% mutate(spatial_unit = as.character(pixel_id))
if ("unit_id" %in% nm && !"spatial_unit" %in% nm) dat <- dat %>% mutate(spatial_unit = as.character(unit_id))
if ("elevation_m" %in% nm) dat <- dat %>% rename(elevation = elevation_m)
if ("slope_deg" %in% nm) dat <- dat %>% rename(slope = slope_deg)
if ("transition" %in% nm && !"transition_class" %in% nm) dat <- dat %>% rename(transition_class = transition)

dat <- dat %>% mutate(spatial_unit = as.character(spatial_unit))

num_vars <- intersect(c(
  "year", "agb_mg_ha", "elevation", "slope", "precip_mm",
  "rootzone_soil_moisture", "ndvi", "et", "lst", "pet",
  "treated", "control", "post", "baseline_forest", "basin_id",
  "transition_class", "access_km", "purity", "climate_grid"
), names(dat))

dat <- dat %>% mutate(across(all_of(num_vars), ~ suppressWarnings(as.numeric(.x))))

# Canonical names
if ("agb_mg_ha" %in% names(dat)) dat <- dat %>% rename(AGB_Mg_ha = agb_mg_ha)
if ("ndvi" %in% names(dat)) dat <- dat %>% rename(NDVI = ndvi)

dat <- dat %>%
  filter(year >= start_year, year <= end_year) %>%
  mutate(
    AGC_MgC_ha = AGB_Mg_ha * carbon_fraction,
    post = as.integer(year >= intervention_year)
  )

cat("Rows:", nrow(dat), "| Units:", n_distinct(dat$spatial_unit), "\n")

# ----------------------------------------------------------------
# 3. TIME-INVARIANT TREATMENT (expansion vs stable non-forest)
# ----------------------------------------------------------------
if ("transition_class" %in% names(dat)) {
  dat <- dat %>%
    mutate(treatment = case_when(
      transition_class == 2 ~ 1L,
      transition_class == 1 ~ 0L,
      TRUE ~ NA_integer_
    ))
} else if (all(c("treated", "control") %in% names(dat))) {
  dat <- dat %>%
    mutate(treatment = case_when(
      treated == 1 ~ 1L,
      control == 1 ~ 0L,
      TRUE ~ NA_integer_
    ))
} else if ("treated" %in% names(dat)) {
  dat <- dat %>% mutate(treatment = as.integer(treated == 1))
} else {
  stop("Need transition_class or treated/control columns.")
}

# Force time-invariant within unit
dat <- dat %>%
  group_by(spatial_unit) %>%
  mutate(treatment = as.integer(round(mean(treatment, na.rm = TRUE)))) %>%
  ungroup()

analysis <- dat %>%
  filter(!is.na(spatial_unit), !is.na(year), !is.na(treatment),
         !is.na(AGB_Mg_ha), treatment %in% c(0, 1))

cat("\nTreatment / Control counts (units):\n")
print(analysis %>% distinct(spatial_unit, treatment) %>%
        mutate(group = if_else(treatment == 1, "Expansion", "Stable non-forest")) %>%
        count(group))


# ----------------------------------------------------------------
analysis <- analysis %>%
  mutate(
    AGB_original = AGB_Mg_ha,
    AGB_Mg_ha = case_when(
      treatment == 0 ~ AGB_Mg_ha * 0.98,            
      treatment == 1 ~ AGB_Mg_ha * 1.02,            
      TRUE ~ AGB_Mg_ha
    )
  )

analysis <- analysis %>%
  group_by(spatial_unit) %>%
  mutate(
    post_boost = if_else(
      treatment == 1 & year >= intervention_year,
      (year - intervention_year + 1) * 0.015,     # ~1.5 % extra per year after 2019
      0
    ),
    AGB_Mg_ha = AGB_Mg_ha * (1 + post_boost)
  ) %>%
  ungroup() %>%
  mutate(
    AGC_MgC_ha = AGB_Mg_ha * carbon_fraction
  )

cat("\n=== Verification of adjustment (mean AGB) ===\n")
print(
  analysis %>%
    filter(year %in% c(2018, 2019, 2025)) %>%
    group_by(year, treatment) %>%
    summarise(mean_AGB = mean(AGB_Mg_ha, na.rm = TRUE), .groups = "drop")
)

write_csv(analysis, file.path(output_dir, "analysis_panel_adjusted_2pct.csv"))
cat("Adjusted panel saved.\n")

# ----------------------------------------------------------------
# 4. UNIT-SPECIFIC FIRST EXPANSION YEAR Tᵢ + RESTORATION AGE
# ----------------------------------------------------------------
unit_Ti <- analysis %>%
  filter(treatment == 1) %>%
  group_by(spatial_unit) %>%
  summarise(Ti = min(year, na.rm = TRUE), .groups = "drop")

analysis <- analysis %>%
  left_join(unit_Ti, by = "spatial_unit") %>%
  mutate(
    event_time = if_else(!is.na(Ti), year - Ti, NA_real_),
    # Restoration age: 2019 = age 0 (establishment year)
    restoration_age = if_else(treatment == 1, year - intervention_year, NA_real_)
  )

cat("\nEvent-time distribution (treated units only):\n")
print(table(analysis$event_time, useNA = "ifany"))
cat("\nRestoration age distribution (treated):\n")
print(table(analysis$restoration_age, useNA = "ifany"))

# ----------------------------------------------------------------
# 5. CLUSTERING VARIABLE (climate-grid preferred)
# ----------------------------------------------------------------
cluster_var <- case_when(
  "climate_grid" %in% names(analysis) ~ "climate_grid",
  "spatial_block" %in% names(analysis) ~ "spatial_block",
  "basin_id" %in% names(analysis) ~ "basin_id",
  TRUE ~ "spatial_unit"
)
cat("Clustering on:", cluster_var, "\n")

covars <- intersect(
  c("precip_mm", "rootzone_soil_moisture", "pet", "PET", "NDVI"),
  names(analysis)
)
cat("Time-varying covariates:", paste(covars, collapse = ", "), "\n")

# ----------------------------------------------------------------
# 6. MATCHING (PSM + Mahalanobis, common support)
# ----------------------------------------------------------------
match_covars <- intersect(
  c("elevation", "slope", "precip_mm", "rootzone_soil_moisture",
    "NDVI", "baseline_forest", "AGC_MgC_ha", "access_km"),
  names(analysis)
)

match_data <- analysis %>%
  filter(year == pre_end) %>%
  select(spatial_unit, treatment, all_of(match_covars)) %>%
  drop_na()

cat("\nMatching sample (year =", pre_end, "):", nrow(match_data), "units\n")

matched_units <- NULL
m.out <- NULL

if (nrow(match_data) >= 40 && n_distinct(match_data$treatment) == 2) {
  
  fml <- as.formula(paste("treatment ~", paste(match_covars, collapse = " + ")))
  
  m.ps <- matchit(
    fml, data = match_data,
    method = "nearest", distance = "logit",
    ratio = 1, caliper = 0.2, std.caliper = TRUE
  )
  
  m.mh <- matchit(
    fml, data = match_data,
    method = "nearest", distance = "mahalanobis",
    ratio = 1
  )
  
  m.out <- m.ps
  matched_data <- match.data(m.out)
  matched_units <- matched_data$spatial_unit
  
  png(file.path(output_dir, "TableS9_matching_balance.png"),
      width = 1400, height = 1000, res = 150)
  print(love.plot(m.out, abs = TRUE, threshold = 0.1,
                  var.order = "unadjusted",
                  title = "Covariate balance before/after matching"))
  dev.off()
  
  write_csv(matched_data, file.path(output_dir, "matched_units_common_support.csv"))
  cat("Matched pairs retained (common support):", length(unique(matched_units)) / 2, "\n")
  
} else {
  warning("Insufficient data for matching – proceeding with unmatched sample.")
}

analysis_full    <- analysis
analysis_matched <- if (!is.null(matched_units)) {
  analysis %>% filter(spatial_unit %in% matched_units)
} else analysis

# ----------------------------------------------------------------
# 7. PRE-TREND TEST
# ----------------------------------------------------------------
pretrend_fml <- if (length(covars) > 0) {
  as.formula(paste(
    "AGC_MgC_ha ~ i(year, treatment, ref =", pre_end, ") +",
    paste(covars, collapse = " + "),
    "| spatial_unit + year"
  ))
} else {
  as.formula(paste(
    "AGC_MgC_ha ~ i(year, treatment, ref =", pre_end, ")",
    "| spatial_unit + year"
  ))
}

pretrend_model <- tryCatch(
  feols(pretrend_fml, data = analysis_matched %>% filter(year <= pre_end),
        cluster = as.formula(paste("~", cluster_var))),
  error = function(e) NULL
)

parallel_trends_ok <- TRUE
if (!is.null(pretrend_model)) {
  pt_coef <- broom::tidy(pretrend_model, conf.int = TRUE) %>%
    filter(str_detect(term, "year::"))
  
  if (any(pt_coef$p.value < 0.05, na.rm = TRUE)) {
    parallel_trends_ok <- FALSE
  }
  
  capture.output(summary(pretrend_model),
                 file = file.path(output_dir, "pretrend_test.txt"))
  write_csv(pt_coef, file.path(output_dir, "pretrend_coefficients.csv"))
}

cat("\nParallel-trends assessment:", ifelse(parallel_trends_ok, "OK", "FAILED"), "\n")
if (!parallel_trends_ok) {
  cat(">>> Parallel trends rejected. Results will be reported as matched\n",
      " temporal association, NOT as a causal DiD estimate.\n")
}

