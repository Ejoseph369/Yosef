# Step 1: Unit-level observed ΔAGC from 2019 to 2025
delta_obs <- analysis_matched %>%
  filter(year %in% c(intervention_year, end_year)) %>%
  group_by(spatial_unit, treatment) %>%
  summarise(
    AGC_2019 = mean(AGC_MgC_ha[year == intervention_year], na.rm = TRUE),
    AGC_2025 = mean(AGC_MgC_ha[year == end_year], na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    delta_AGC_obs = AGC_2025 - AGC_2019,
    years_elapsed = end_year - intervention_year   # 6 years
  )

# Step 2: Attach environmental covariates (unit-level means / baseline)
env_unit <- analysis_matched %>%
  group_by(spatial_unit) %>%
  summarise(
    elevation     = mean(elevation, na.rm = TRUE),
    slope         = mean(slope, na.rm = TRUE),
    water_mean    = mean(rootzone_soil_moisture, na.rm = TRUE),
    precip_mean   = mean(precip_mm, na.rm = TRUE),
    .groups = "drop"
  )

# Baseline AGC at establishment (2019)
base_2019 <- analysis_matched %>%
  filter(year == intervention_year) %>%
  group_by(spatial_unit) %>%
  summarise(AGC_baseline_2019 = mean(AGC_MgC_ha, na.rm = TRUE), .groups = "drop")

# Restoration age at end of period (for treated)
age_end <- analysis_matched %>%
  filter(year == end_year, treatment == 1) %>%
  distinct(spatial_unit, restoration_age) %>%
  rename(age_at_2025 = restoration_age)

cre_star_data <- delta_obs %>%
  left_join(env_unit, by = "spatial_unit") %>%
  left_join(base_2019, by = "spatial_unit") %>%
  left_join(age_end, by = "spatial_unit") %>%
  mutate(
    # For controls, age is conceptually 0 or NA; we use only treated for CRE*
    age_at_2025 = if_else(treatment == 1, age_at_2025, 0)
  )

# Step 3: Reference model for expected ΔAGC
# E(ΔAGC) = f(Age, AGC_2019, Water, Elevation, Slope)
# Fit on the whole sample (or treated only – both are justifiable)
ref_model <- tryCatch(
  lm(delta_AGC_obs ~ age_at_2025 + AGC_baseline_2019 + water_mean + elevation + slope,
     data = cre_star_data),
  error = function(e) {
    message("Reference model failed: ", e$message)
    NULL
  }
)

if (!is.null(ref_model)) {
  cat("\n=== Reference model for expected ΔAGC ===\n")
  print(summary(ref_model))
  capture.output(summary(ref_model),
                 file = file.path(output_dir, "CRE_star_reference_model.txt"))
  
  # Predict expected ΔAGC
  cre_star_data <- cre_star_data %>%
    mutate(
      delta_AGC_expected = predict(ref_model, newdata = .),
      # Observed additional = treated ΔAGC minus control-group mean ΔAGC
      # (or simply the treated ΔAGC if one prefers absolute realization)
      control_mean_delta = mean(delta_AGC_obs[treatment == 0], na.rm = TRUE),
      delta_AGC_additional = if_else(treatment == 1,
                                     delta_AGC_obs - control_mean_delta,
                                     NA_real_),
      # CRE* = observed additional / expected
      CRE_star = delta_AGC_additional / delta_AGC_expected
    )
  
  # Summary of CRE*
  cre_star_summary <- cre_star_data %>%
    filter(treatment == 1, is.finite(CRE_star)) %>%
    summarise(
      n = n(),
      mean_CRE_star   = mean(CRE_star, na.rm = TRUE),
      median_CRE_star = median(CRE_star, na.rm = TRUE),
      sd_CRE_star     = sd(CRE_star, na.rm = TRUE),
      prop_gt_1       = mean(CRE_star > 1, na.rm = TRUE),
      prop_lt_1       = mean(CRE_star < 1, na.rm = TRUE)
    )
  
  cat("\n=== CRE* Summary (treated units) ===\n")
  print(cre_star_summary)
  
  write_csv(cre_star_data, file.path(output_dir, "unit_level_CRE_star.csv"))
  write_csv(cre_star_summary, file.path(output_dir, "CRE_star_summary.csv"))
  
  # Classification
  cre_star_data <- cre_star_data %>%
    mutate(
      CRE_star_class = case_when(
        is.na(CRE_star) ~ NA_character_,
        CRE_star > 1.1  ~ "greater-than-expected",
        CRE_star < 0.9  ~ "lower-than-expected",
        TRUE            ~ "approximately-expected"
      )
    )
  
  cat("\nCRE* classification counts:\n")
  print(table(cre_star_data$CRE_star_class[cre_star_data$treatment == 1], useNA = "ifany"))
}

